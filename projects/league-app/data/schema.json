{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "League App Data",
  "type": "object",
  "required": [
    "version",
    "league",
    "teams",
    "players",
    "matches"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "updatedAt": {
      "type": "string"
    },
    "league": {
      "type": "object",
      "required": [
        "name",
        "season",
        "settings"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "season": {
          "type": "string"
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ]
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "teamId",
          "name"
        ]
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "homeTeamId",
          "awayTeamId",
          "status"
        ]
      }
    }
  }
}